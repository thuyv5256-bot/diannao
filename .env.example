# 店脑 · LLM 说明层配置
# 复制本文件为 .env 并填入真实密钥即可启用「💬 用大白话解释」的 AI 讲解。
# 未配置时，界面自动降级为规则模板解读，核心补货决策不受任何影响。

# DeepSeek（默认，OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 也可改接 OpenAI / 通义 DashScope 兼容模式 / 本地 vLLM（取消注释并修改）：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=8
